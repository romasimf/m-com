<div class="grid min-h-screen grid-cols-1 items-center gap-3 px-6 py-9 lg:grid-cols-[minmax(320px,1.05fr)_minmax(420px,0.95fr)] lg:gap-12 lg:px-16 lg:py-12">
  <div class="flex min-h-0 items-center justify-center pt-3 lg:min-h-[520px] lg:pt-0">
    <div class="flex w-[min(240px,64vw)] items-center justify-center lg:w-[min(520px,100%)]">
      <%= image_tag "logo.png", alt: "m.com", class: "block h-auto w-[240px] object-contain drop-shadow-[0_10px_24px_rgba(0,0,0,0.22)] sm:w-[320px] lg:w-[450px]" %>
    </div>
  </div>
  <div class="w-full max-w-[560px] justify-self-center lg:max-w-[520px] lg:justify-self-start">
    <div class="mb-6 lg:mb-9">
      <h1 class="m-0 text-[clamp(52px,7vw,84px)] font-medium leading-[0.92] tracking-[-0.05em]"><span class="block">Место</span><span class="block lg:pl-[31%]">для</span><span class="block lg:pl-[58%]">своих</span></h1>
    </div>
    <p class="mb-7 mt-0 text-[clamp(22px,2.3vw,34px)] font-normal leading-tight tracking-[0.10em] text-[#f4f4f4] sm:tracking-[0.16em]">Присоединяйся к платформе уже сегодня</p>
    <% if user_signed_in? %>
      <div class="flex flex-col gap-[18px]"><p class="m-0 text-[clamp(24px,2vw,30px)] leading-tight tracking-[-0.03em]">Вы уже в m.com</p><p class="text-xl text-[#8a9098]"><strong><%= current_user.email %></strong></p><%= button_to "Выйти", destroy_user_session_path, method: :delete, class: "inline-flex min-h-[70px] w-[min(100%,342px)] cursor-pointer items-center justify-center rounded-full border border-white/90 bg-black/80 px-7 text-2xl font-normal leading-none tracking-[0.08em] text-[#f4f4f4] transition hover:-translate-y-px hover:bg-white/5" %></div>
    <% else %>
      <div class="mb-2"><%= link_to "Создать аккаунт", new_user_registration_path, class: "inline-flex min-h-[70px] w-[min(100%,342px)] items-center justify-center rounded-full border border-transparent bg-[#d9d9d9] px-7 text-2xl font-normal leading-none tracking-[0.08em] text-[#101010] transition hover:-translate-y-px hover:bg-[#cfcfcf]" %></div>
      <p class="mb-[54px] mt-3 w-[min(100%,342px)] text-sm leading-[1.35] text-[#6d737b]">Регистрируясь, вы соглашаетесь с Условиями использования и Политикой конфиденциальности.</p>
      <div class="flex flex-col gap-[18px]"><p class="m-0 text-[clamp(24px,2vw,30px)] leading-tight tracking-[-0.03em]">Уже зарегистрированы?</p><%= link_to "Войти", new_user_session_path, class: "inline-flex min-h-[70px] w-[min(100%,342px)] items-center justify-center rounded-full border border-white/90 bg-black/80 px-7 text-2xl font-normal leading-none tracking-[0.08em] text-[#f4f4f4] transition hover:-translate-y-px hover:bg-white/5" %></div>
    <% end %>
  </div>
</div>

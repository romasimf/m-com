<% author = post.user %>
<%= link_to user_profile_path(author),
    class: "block border-b border-white/10 px-4 py-4 transition hover:bg-white/5 sm:px-6 sm:py-5" do %>

  <div class="flex gap-4">
    <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-[#1e1e1e]">
      <% if author.avatar.attached? %>
        <%= image_tag author.avatar,
            alt: "Аватар",
            class: "h-full w-full object-cover" %>
      <% else %>
        <%= image_tag "avatar.png",
            alt: "Аватар",
            class: "h-full w-full object-cover" %>
      <% end %>
    </div>

    <div class="min-w-0 flex-1">
      <div class="flex items-start justify-between gap-3">
        <div class="min-w-0">
          <div class="truncate text-base font-bold text-white">
            Новый пост от <%= author.name.presence || author.email.split("@").first.capitalize %>
          </div>

          <div class="truncate text-sm text-[#8a9098]">
            @<%= author.username.presence || author.email.split("@").first.downcase %>
            ·
            <%= post.created_at.strftime("%d.%m.%Y %H:%M") %>
          </div>
        </div>

        <span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#00c853]"></span>
      </div>

      <% if post.body.present? %>
        <p class="mt-3 line-clamp-3 whitespace-pre-wrap break-words text-sm leading-6 text-[#d7d7d7]"><%= post.body.to_s.strip %></p>
      <% end %>

      <% if post.images.attached? %>
        <div class="mt-3 text-sm text-[#8a9098]">
          Фотографий: <%= [post.images.size, 5].min %>
        </div>
      <% end %>
    </div>
  </div>
<% end %>

<% sender = message.user %>
<%= link_to conversation_path(message.conversation),
    class: "flex gap-4 border-b border-white/10 px-4 py-4 transition hover:bg-white/5 sm:px-6 sm:py-5" do %>

  <div class="h-12 w-12 shrink-0 overflow-hidden rounded-full bg-[#1e1e1e]">
    <% if sender.avatar.attached? %>
      <%= image_tag sender.avatar,
          alt: "Аватар",
          class: "h-full w-full object-cover" %>
    <% else %>
      <%= image_tag "avatar.png",
          alt: "Аватар",
          class: "h-full w-full object-cover" %>
    <% end %>
  </div>

  <div class="min-w-0 flex-1">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="truncate text-base font-bold text-white">
          Новое сообщение от <%= sender.name.presence || sender.email.split("@").first.capitalize %>
        </div>

        <div class="truncate text-sm text-[#8a9098]">
          @<%= sender.username.presence || sender.email.split("@").first.downcase %>
          ·
          <%= message.created_at.strftime("%d.%m.%Y %H:%M") %>
        </div>
      </div>

      <span class="mt-1 h-3 w-3 shrink-0 rounded-full bg-[#1d9bf0]"></span>
    </div>

    <p class="mt-3 line-clamp-2 break-words text-sm leading-6 text-[#d7d7d7]"><%= message.body.to_s.strip %></p>
  </div>
<% end %>

<div class="mx-auto grid min-h-screen justify-center overflow-x-hidden bg-[#050c14] text-[#f4f4f4] md:grid-cols-[260px_minmax(0,900px)] xl:grid-cols-[260px_minmax(700px,900px)_320px]">
  <%= render "shared/sidebar" %>

  <main class="flex h-screen w-full max-w-[900px] flex-col border-white/10 md:border-r">
    <div class="shrink-0 border-b border-white/10 px-4 py-4 sm:px-6 sm:py-5">
      <h1 class="m-0 text-xl font-semibold leading-tight sm:text-[28px]">
        Сообщения
      </h1>
    </div>

    <%= turbo_stream_from "messages_for_user_#{current_user.id}" %>
<%= turbo_stream_from "sidebar_for_user_#{current_user.id}" %>

    <section class="flex min-h-0 flex-1 border-b border-white/10 lg:grid lg:grid-cols-[330px_minmax(0,1fr)]">
      <aside class="hidden overflow-y-auto border-b border-white/10 lg:block lg:border-b-0 lg:border-r">
        <div class="border-b border-white/10 p-4">
          <%= form_with url: messages_path, method: :get, local: true do %>
            <%= text_field_tag :q,
                @search_query,
                placeholder: "Поиск пользователей",
                class: "min-h-[46px] w-full rounded-full border border-white/10 bg-white/10 px-[18px] text-white outline-none placeholder:text-[#8a9098] focus:border-white/25" %>
          <% end %>
        </div>

        <% if @search_query.present? %>
          <div class="border-b border-white/10 p-4">
            <h2 class="mb-3 text-sm font-bold text-[#8a9098]">
              Найденные пользователи
            </h2>

            <% if @search_results.any? %>
              <div class="space-y-2">
                <% @search_results.each do |user| %>
                  <%= button_to messages_path,
                      method: :post,
                      params: { user_id: user.id },
                      form: { class: "w-full" },
                      class: "flex w-full cursor-pointer items-center gap-3 rounded-2xl border-0 bg-transparent p-3 text-left transition hover:bg-white/10" do %>

                    <div class="h-11 w-11 shrink-0 overflow-hidden rounded-full bg-[#1e1e1e]">
                      <% if user.avatar.attached? %>
                        <%= image_tag user.avatar, class: "h-full w-full object-cover" %>
                      <% else %>
                        <%= image_tag "avatar.png", class: "h-full w-full object-cover" %>
                      <% end %>
                    </div>

                    <div class="min-w-0">
                      <div class="truncate text-sm font-bold text-white">
                        <%= user.display_name %>
                      </div>

                      <div class="truncate text-xs text-[#8a9098]">
                        @<%= user.tag_name %>
                      </div>
                    </div>
                  <% end %>
                <% end %>
              </div>
            <% else %>
              <p class="text-sm text-[#8a9098]">
                Пользователи не найдены.
              </p>
            <% end %>
          </div>
        <% end %>

        <div id="sidebar-conversations">
          <% if @conversations.any? %>
            <% @conversations.each do |conversation| %>
              <% active = @conversation.present? && @conversation.id == conversation.id %>
              <div id="conv_sidebar_<%= conversation.id %>" class="<%= active ? 'bg-white/10' : '' %>">
                <%= render "conversations/conversation_sidebar", conversation: conversation %>
              </div>
            <% end %>
          <% else %>
            <div class="px-5 py-8 text-sm text-[#8a9098]">
              Пока нет диалогов.
            </div>
          <% end %>
        </div>
      </aside>

      <div class="flex min-h-0 flex-1 flex-col">
        <div class="shrink-0 flex items-center gap-3 border-b border-white/10 px-5 py-4">
          <div class="h-12 w-12 overflow-hidden rounded-full bg-[#1e1e1e]">
            <% if @other_user.avatar.attached? %>
              <%= image_tag @other_user.avatar, class: "h-full w-full object-cover" %>
            <% else %>
              <%= image_tag "avatar.png", class: "h-full w-full object-cover" %>
            <% end %>
          </div>

          <div class="min-w-0">
            <div class="truncate text-lg font-bold text-white">
              <%= @other_user.display_name %>
            </div>

            <div class="truncate text-sm text-[#8a9098]">
              @<%= @other_user.tag_name %>
            </div>
          </div>
        </div>

        <div id="messages" class="flex-1 space-y-3 overflow-y-auto px-5 py-5">
          <% if @messages.any? %>
            <% @messages.each do |message| %>
              <% mine = message.user == current_user %>

              <div class="flex <%= mine ? 'justify-end' : 'justify-start' %>">
                <div class="max-w-[75%]">
                  <div class="<%= mine ? 'bg-[#1d9bf0] text-white' : 'bg-white/10 text-[#f4f4f4]' %> rounded-[24px] px-4 py-3">
                    <p class="whitespace-pre-wrap break-words text-sm leading-6"><%= message.body.to_s.strip %></p>
                  </div>

                  <div class="<%= mine ? 'text-right' : 'text-left' %> mt-1 text-xs text-[#8a9098]">
                    <%= message.created_at.strftime("%d.%m.%Y %H:%M") %>
                  </div>
                </div>
              </div>
            <% end %>
          <% else %>
            <div class="flex h-full items-center justify-center text-center text-[#8a9098]">
              <div>
                <div class="text-2xl font-bold text-white">
                  Начните диалог
                </div>

                <p class="mt-2">
                  Напишите первое сообщение пользователю.
                </p>
              </div>
            </div>
          <% end %>
        </div>

        <div class="shrink-0 border-t border-white/10 p-4">
          <%= form_with model: @message,
              url: conversation_messages_path(@conversation),
              method: :post,
              class: "flex items-end gap-3" do |f| %>

            <%= f.text_area :body,
                placeholder: "Написать сообщение",
                rows: 1,
                class: "min-h-[48px] max-h-[160px] flex-1 resize-none rounded-[24px] border border-white/10 bg-white/10 px-5 py-3 text-sm text-white outline-none placeholder:text-[#8a9098] focus:border-white/25" %>

            <%= f.submit "Отправить",
                class: "min-h-[48px] cursor-pointer rounded-full border-0 bg-[#f1f1f1] px-6 font-bold text-[#111] transition hover:bg-[#d9d9d9]" %>
          <% end %>
        </div>
      </div>
    </section>
  </main>

  <aside class="hidden xl:block"></aside>
</div>

<% unread = unread_messages_count(current_user) %>
<%= turbo_stream.replace "unread-badge-sidebar-count", partial: "messages/badge_count", locals: { count: unread, target_id: "unread-badge-sidebar-count" } %>
<%= turbo_stream.replace "unread-badge-mobile-count", partial: "messages/badge_count", locals: { count: unread, target_id: "unread-badge-mobile-count" } %>

<script>
(function() {
  function scrollMessages() {
    var el = document.getElementById("messages");
    if (el) el.scrollTop = el.scrollHeight;
  }
  scrollMessages();
  var el = document.getElementById("messages");
  if (el) {
    var obs = new MutationObserver(scrollMessages);
    obs.observe(el, { childList: true });
  }
  document.addEventListener("turbo:load", function() {
    var el2 = document.getElementById("messages");
    if (el2) el2.scrollTop = el2.scrollHeight;
  });
  var mf = document.querySelector("textarea[name='message[body]']");
  if (mf) {
    mf.form.addEventListener("submit", function() {
      setTimeout(function() { mf.value = ""; }, 0);
    });
  }
})();
</script>
<div class="mx-auto grid min-h-screen justify-center bg-[#050c14] text-[#f4f4f4] md:grid-cols-[260px_minmax(0,900px)] xl:grid-cols-[260px_minmax(700px,900px)_320px]">
  <%= render "shared/sidebar" %>

  <main class="min-h-screen w-full max-w-[900px] border-white/10 pb-10 md:mt-3 md:border-r">
    <div class="border-b border-white/10 px-6 py-5">
      <h1 class="m-0 text-[28px] font-semibold leading-tight"><%= local_assigns[:title] || "Новый пост" %></h1>
    </div>

    <section class="px-4 py-6 sm:px-6">
      <div class="rounded-[28px] border border-white/10 bg-[#07111c]/90 p-4 shadow-[0_24px_80px_rgba(0,0,0,0.28)] sm:p-6">
        <%= form_with model: @post, local: true, html: { multipart: true, class: "space-y-5", data: { turbo: false } } do |f| %>
          <% if @post.errors.any? %>
            <div class="rounded-2xl border border-red-300/30 bg-red-900/25 p-4 text-sm text-red-100">
              <% @post.errors.full_messages.each do |message| %>
                <p>• <%= message %></p>
              <% end %>
            </div>
          <% end %>

          <div class="flex gap-4">
            <%= image_tag "avatar.png", alt: "Аватар", class: "h-12 w-12 shrink-0 rounded-full object-cover" %>

            <div class="w-full min-w-0">
              <%= f.text_area :body,
                    class: "min-h-[170px] w-full resize-none border-0 bg-transparent text-xl leading-8 text-[#f4f4f4] outline-none placeholder:text-[#6d737b]",
                    placeholder: "Напишите публикацию",
                    rows: 5 %>

              <% existing_images = @post.images.map { |image| { id: image.id, url: url_for(image) } } %>

              <div
                id="post-images-gallery"
                class="mt-4 hidden overflow-hidden rounded-[22px] border border-white/10 bg-black/20"
                data-existing-images='<%= raw existing_images.to_json %>'>
              </div>

              <p id="image-preview-counter" class="mt-2 hidden text-sm text-[#8a9098]">Можно добавить до 6 фотографий</p>
              <div id="removed-images-container"></div>

              <%= f.file_field :images,
                    multiple: true,
                    accept: "image/*",
                    class: "hidden",
                    id: "post-images-input",
                    data: { max_files: 6 } %>

              <div class="mt-5 flex flex-col gap-3 border-t border-white/10 pt-5 sm:flex-row sm:items-center sm:justify-between">
                <label for="post-images-input" class="inline-flex cursor-pointer items-center gap-2 text-base text-[#d7d7d7] transition hover:text-white">
                  <span class="flex h-9 w-9 items-center justify-center rounded-full bg-white/10 text-xl">+</span>
                  <span>Добавить фото <span class="text-sm text-[#8a9098]">(до 6)</span></span>
                </label>

                <div class="flex flex-wrap gap-3">
                  <%= link_to "Назад", profile_path, class: "inline-flex min-h-[46px] items-center justify-center rounded-full border border-white/35 px-6 text-white transition hover:bg-white/5" %>
                  <%= f.submit local_assigns[:button_text] || "Опубликовать", class: "inline-flex min-h-[46px] cursor-pointer items-center justify-center rounded-full border-0 bg-[#f1f1f1] px-7 text-[#111] transition hover:bg-[#d9d9d9]" %>
                </div>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    </section>
  </main>

  <aside class="hidden px-[18px] pt-[18px] xl:block">
    <input type="text" placeholder="Поиск" class="min-h-[50px] w-full rounded-full border-0 bg-white/10 px-[18px] text-white outline-none placeholder:text-[#8a9098]">
  </aside>
</div>

<div class="profile-page">
  <aside class="profile-sidebar">
    <div class="profile-brand">
      <%= image_tag "logo.png", alt: "m.com", class: "profile-brand-logo" %>
    </div>

    <nav class="profile-nav">
      <%= link_to "#", class: "profile-nav-item" do %>
        <%= image_tag "home.png", class: "profile-nav-icon" %>
        <span>Главная</span>
      <% end %>

      <%= link_to "#", class: "profile-nav-item" do %>
        <%= image_tag "settings.png", class: "profile-nav-icon" %>
        <span>Настройки</span>
      <% end %>

      <%= link_to "#", class: "profile-nav-item" do %>
        <%= image_tag "notifications.png", class: "profile-nav-icon" %>
        <span>Уведомления</span>
      <% end %>

      <%= link_to "#", class: "profile-nav-item" do %>
        <%= image_tag "messages.png", class: "profile-nav-icon" %>
        <span>Сообщения</span>
      <% end %>

      <%= link_to profile_path, class: "profile-nav-item active" do %>
        <%= image_tag "profile.png", class: "profile-nav-icon" %>
        <span>Профиль</span>
      <% end %>
    </nav>

    <div class="profile-logout">
      <%= button_to "Выйти",
          destroy_user_session_path,
          method: :delete,
          class: "profile-logout-btn" %>
    </div>
  </aside>

  <main class="profile-main">
    <div class="post-create-card">
      <div class="post-create-header">
        <%= image_tag "post-icon.png", alt: "post icon", class: "post-header-icon" %>
        <h2 class="post-create-title">Новый пост</h2>
      </div>

      <%= form_with model: @post, local: true do |f| %>
        <% if @post.errors.any? %>
          <div style="color: #ff6b6b; margin-bottom: 16px;">
            <ul>
              <% @post.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div id="images-limit-error-wrap" style="color: #ff6b6b; margin-bottom: 16px;" class="hidden">
          <ul>
            <li id="images-limit-error"></li>
          </ul>
        </div>

        <div class="post-create-body">
          <div class="post-media-upload">
            <label class="upload-area" id="add-more-images-btn" for="post-images-input">
              <div class="upload-placeholder" id="upload-placeholder">
                <%= image_tag "upload-arrow.png", alt: "upload", class: "upload-arrow-icon" %>
                <span class="upload-text">Добавьте фото</span>
              </div>
            </label>

            <div
              id="post-images-preview"
              class="post-images-preview hidden"
              data-existing-count="0"
            ></div>

            <%= f.file_field :images,
                  multiple: true,
                  accept: "image/*",
                  style: "display: none;",
                  id: "post-images-input" %>
          </div>

          <div class="post-textarea-wrap">
            <%= f.text_area :body,
                  class: "post-textarea",
                  placeholder: "Напишите что-нибудь...",
                  rows: 3 %>
          </div>

          <%= f.submit "Опубликовать", class: "post-submit-btn" %>
        </div>
      <% end %>
    </div>
  </main>

  <aside class="profile-rightbar">
    <input type="text" placeholder="Поиск" class="profile-search">
  </aside>
</div>

<script>
  function initNewPostPreview() {
    const input = document.getElementById("post-images-input");
    const preview = document.getElementById("post-images-preview");
    const addButton = document.getElementById("add-more-images-btn");
    const placeholder = document.getElementById("upload-placeholder");
    const limitError = document.getElementById("images-limit-error");
    const limitErrorWrap = document.getElementById("images-limit-error-wrap");

    if (!input || !preview || !addButton || !placeholder || !limitError || !limitErrorWrap) return;
    if (input.dataset.previewInit === "true") return;
    input.dataset.previewInit = "true";

    let selectedFiles = [];

    function syncInputFiles() {
      const dt = new DataTransfer();
      selectedFiles.forEach((file) => dt.items.add(file));
      input.files = dt.files;
    }

    function showLimitError(message) {
      limitError.textContent = message;
      limitErrorWrap.classList.remove("hidden");
    }

    function hideLimitError() {
      limitError.textContent = "";
      limitErrorWrap.classList.add("hidden");
    }

    function removeNewPreviews() {
      preview.querySelectorAll(".new-image-preview").forEach((item) => item.remove());
    }

    function updateUI() {
      const totalCount = selectedFiles.length;

      if (totalCount > 0) {
        preview.classList.remove("hidden");
      } else {
        preview.classList.add("hidden");
      }

      if (totalCount >= 5) {
        addButton.classList.add("hidden");
        placeholder.classList.add("hidden");
      } else {
        addButton.classList.remove("hidden");
        placeholder.classList.remove("hidden");
      }
    }

    function renderNewPreviews() {
      removeNewPreviews();

      selectedFiles.forEach((file, index) => {
        if (!file.type.startsWith("image/")) return;

        const reader = new FileReader();

        reader.onload = function (event) {
          const item = document.createElement("div");
          item.className = "post-preview-item new-image-preview";

          const img = document.createElement("img");
          img.src = event.target.result;
          img.alt = file.name;
          img.className = "post-preview-image";

          const removeBtn = document.createElement("button");
          removeBtn.type = "button";
          removeBtn.className = "image-remove-btn";
          removeBtn.innerHTML = "&times;";

          removeBtn.addEventListener("click", () => {
            selectedFiles.splice(index, 1);
            syncInputFiles();
            renderNewPreviews();
            updateUI();
            hideLimitError();
          });

          item.appendChild(img);
          item.appendChild(removeBtn);
          preview.appendChild(item);
        };

        reader.readAsDataURL(file);
      });
    }

    input.addEventListener("change", function () {
      hideLimitError();

      const newFiles = Array.from(input.files || []);
      const availableSlots = 5 - selectedFiles.length;

      if (availableSlots <= 0) {
        showLimitError("Можно загрузить не больше 5 фото");
        syncInputFiles();
        updateUI();
        return;
      }

      if (newFiles.length > availableSlots) {
        showLimitError("Можно загрузить не больше 5 фото");
      }

      const filesToAdd = newFiles.slice(0, availableSlots);
      selectedFiles = selectedFiles.concat(filesToAdd);

      syncInputFiles();
      renderNewPreviews();
      updateUI();
    });

    renderNewPreviews();
    updateUI();
  }

  document.addEventListener("DOMContentLoaded", initNewPostPreview);
  document.addEventListener("turbo:load", initNewPostPreview);
</script>